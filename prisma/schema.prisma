// Schema do MVP — e-commerce de perfumaria Lamora.
// Ver docs/spec.md §6. LGPD: exclusão de usuário anonimiza, nunca dá DELETE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  PERFUME
  HIDRATANTE
  ESFOLIANTE
  SKIN_CARE
}

enum NoteTier {
  TOPO
  CORACAO
  FUNDO
}

enum UserStatus {
  ACTIVE
  ANONYMIZED
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  password    String
  birthDate   DateTime
  phone       String
  status      UserStatus @default(ACTIVE)
  // Acesso ao painel administrativo (ver tarefa 07). Promoção manual via
  // banco — não há UI para conceder o papel no MVP.
  isAdmin     Boolean    @default(false)
  lgpdConsent Boolean    @default(false)
  consentAt   DateTime?
  createdAt   DateTime   @default(now())
  cart        Cart?
}

model Product {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  brand     String
  price     Decimal         @db.Decimal(10, 2)
  category  Category
  shortDesc String
  fullDesc  String
  stock     Int             @default(0)
  images    ProductImage[]
  olfactory OlfactoryNote[] // só preenchido para PERFUME
  createdAt DateTime        @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int // ordem de exibição
  isPrimary Boolean @default(false)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model OlfactoryNote {
  id        String   @id @default(cuid())
  name      String
  tier      NoteTier
  intensity Int // escala 1..5 para barra visual
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int    @default(1)
}

// Eventos de conversão para o dashboard admin (ver docs/tasks/10).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // SESSION | SIGNUP | CART_ADD | WHATSAPP_SEND
  metadata  Json?
  createdAt DateTime @default(now())
}
