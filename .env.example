# Banco de dados PostgreSQL (ver docker-compose.yml para o ambiente local).
DATABASE_URL="postgresql://lamora:lamora@localhost:5433/lamora?schema=public"

# Telefone da loja para o checkout via WhatsApp (formato wa.me, só dígitos).
STORE_PHONE="5585999999999"

# Segredo HMAC-SHA256 para assinar cookies de sessão. Gere um valor único com:
# node -e "const{randomBytes}=require('crypto');console.log(randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Amazon S3 — upload de imagens de produtos (painel admin).
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
# Opcional: URL pública customizada (ex.: CloudFront). Sem isso, usa o endpoint do bucket.
# AWS_S3_PUBLIC_URL_BASE="https://cdn.exemplo.com"
